# Copy this file to .env and fill in the values. Never commit .env.
# Local development database (PostgreSQL on this laptop).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shadidesk_local?schema=public"

# Tests use their own database. Make it with `createdb shadidesk_test`, then put the same
# address with the database name shadidesk_test in a file named .env.test (never committed).
