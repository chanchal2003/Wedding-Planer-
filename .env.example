# Copy this file to .env and fill in the values. Never commit .env.
# Local development database (PostgreSQL on this laptop).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shadidesk_local?schema=public"

# Sign-in with Google (plan step 4.1). Create the keys in Google Cloud: see the build plan.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Locks the sign-in cookies. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The address of the app on this laptop (the dev server uses port 3001).
BETTER_AUTH_URL="http://localhost:3001"

# Tests use their own database. Make it with `createdb shadidesk_test`, then put the same
# address with the database name shadidesk_test in a file named .env.test (never committed).
